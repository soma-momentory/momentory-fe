# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# 네이티브 폴더는 생성물이다 (CNG — Continuous Native Generation).
# `npx expo prebuild` 로 언제든 다시 만들어지므로 이력에 담지 않는다.
# 네이티브를 고쳐야 하면 여기가 아니라 config plugin 을 고친다.
/ios
/android
.kotlin/
*.orig.*

# 서명 키 — 절대 커밋하지 않는다
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.pem

# 시크릿.
# 카카오 네이티브 앱 키 · Google 클라이언트 ID · Firebase 설정 파일이 여기 산다.
# app.config.ts 가 env 에서 읽고, 공유되는 것은 .env.example 뿐이다.
# 빌드·CI 는 EAS Secrets 를 쓴다.
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# typescript
*.tsbuildinfo

# 테스트·커버리지
coverage/

# OS · OneDrive 부산물
.DS_Store
Thumbs.db
desktop.ini

# 에디터 개인 설정 (권장 설정 예시는 docs/SETUP.md §7)
.vscode/

# Claude Code 로컬 설정 (기기별 권한 허용 목록)
.claude/settings.local.json

# 디자인 반입 원본 아카이브 — 정본만 `docs/DESIGN.md` 로 남기고 나머지는 지웠다
# (2026-08-20 · `PLAN.md` A-18). 압축본을 이력에 담지 않는 것은 그대로다
/Momentory design system.zip

# 기기 버그리포트 — 로그·기기 식별자·계정/네트워크 진단이 들어 있다.
# 디버깅용으로 받아 두는 것은 자유지만 이력에는 담지 않는다.
bugreport*.zip

# 감각연못 일러스트의 **디자이너 원본** — 앱이 쓰는 것은 여백을 잘라 낸
# `assets/sensory-pond/*.png` 이고, 원본은 8MB 가 넘어 이력에 담지 않는다.
# 그림이 바뀌면 원본을 여기 두고 앱용을 다시 만든다 (docs/DESIGN.md 「감각연못」)
assets/sensory-pond/source/
assets/body-release/source/

# 화면 크기 훑기 결과 — `scripts/screen-sweep.sh` 가 찍는 스크린샷 수백 장.
# 그때그때 눈으로 보고 버리는 것이라 이력에 담지 않는다
.screen-sweep/
