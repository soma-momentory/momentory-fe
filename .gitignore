# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# 네이티브 폴더는 생성물이다 (CNG — Continuous Native Generation).
# `npx expo prebuild` 로 언제든 다시 만들어지므로 이력에 담지 않는다.
# 네이티브를 고쳐야 하면 여기가 아니라 config plugin 을 고친다.
/ios
/android
.kotlin/
*.orig.*

# 서명 키 — 절대 커밋하지 않는다
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# 시크릿.
# 카카오 네이티브 앱 키 · Google 클라이언트 ID · Firebase 설정 파일이 여기 산다.
# app.config.ts 가 env 에서 읽고, 공유되는 것은 .env.example 뿐이다.
# 빌드·CI 는 EAS Secrets 를 쓴다.
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# typescript
*.tsbuildinfo

# 테스트·커버리지
coverage/

# OS · OneDrive 부산물
.DS_Store
Thumbs.db
desktop.ini

# Claude Code 로컬 설정 (기기별 권한 허용 목록)
.claude/settings.local.json
