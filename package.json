{
  "name": "momentory",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "workspaces": [
    "expo-lab"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "typecheck:lab": "npm run typecheck --prefix design-lab",
    "typecheck:expo-lab": "npm run typecheck --workspace momentory-expo-lab",
    "lab:web": "npm run web --workspace momentory-expo-lab --",
    "design:apply": "node expo-lab/scripts/apply-design.mjs",
    "test:visual": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:api": "node scripts/sync-api.mjs",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.8.0",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-seoul/kakao-login": "^6.0.4",
    "expo": "~57.0.23",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.21",
    "expo-calendar": "~57.0.2",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@amplitude/analytics-react-native": {
      "@react-native-async-storage/async-storage": "$@react-native-async-storage/async-storage"
    }
  }
}
