# 이 파일은 커밋한다. 실제 값이 담긴 .env 는 커밋하지 않는다.
# 값을 받으려면 팀 시크릿 저장소(EAS Secrets)를 본다.
#
#   cp .env.example .env   후 값을 채운다

# Xcode 배포용 prebuild에서만 production으로 지정한다.
# production이면 아래 네 값이 모두 필요하고 API 주소는 반드시 HTTPS여야 한다.
# 개발 중에는 비우거나 development로 둔다.
MOMENTORY_BUILD_ENV=development

# 카카오 로그인 — 네이티브 앱 키 (Kakao Developers)
EXPO_PUBLIC_KAKAO_APP_KEY=

# 구글 로그인 — OAuth 클라이언트 ID (Google Cloud Console)
# ⚠ 웹 클라이언트 ID 는 Android 에서도 필요하다 — 그것이 serverClientId 로 가고
#    서버가 검증할 ID token 의 aud 가 된다. 비면 Android 로그인이 토큰 없이 끝난다.
# iOS 역순 스킴은 여기 두지 않는다 — iOS 클라이언트 ID 에서 app.config.ts 가 만든다.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# API 서버 — 스킴까지 적는다(예: https://api.example.com).
# 비우면 서버로 가는 호출이 전부 실패로 닫힌다 — 로그인도 되지 않는다.
# ⚠ `http://` 이면 그 호스트 하나에만 평문 예외가 열린다(plugins/withInsecureDevApi.ts).
#    값을 바꾸면 네이티브 설정이 바뀌므로 다시 prebuild 해야 한다.
EXPO_PUBLIC_API_BASE_URL=

# Amplitude 프로젝트의 클라이언트 수집 API Key (Secret Key가 아니다).
# 비우면 analytics만 꺼진다. main 브랜치 하나로 운영해도 사용할 수 있다.
EXPO_PUBLIC_AMPLITUDE_API_KEY=
# 개발 빌드 수집은 기본 차단. 테스트 이벤트를 확인할 때만 true.
# 배포 빌드에는 영향을 주지 않는다.
EXPO_PUBLIC_AMPLITUDE_ALLOW_DEVELOPMENT=false
